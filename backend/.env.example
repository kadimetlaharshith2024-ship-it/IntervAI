# IntervAI Backend Environment Configuration Example
# Copy this file to .env and configure your local credentials.
# NEVER commit .env with real secrets to version control!

# Environment mode: development, test, production
ENVIRONMENT=development

# Database connection URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/intervai

# LLM Provider selection: gemini, openai, mock
LLM_PROVIDER=gemini
LLM_MODEL_NAME=gemini-3.1-flash-lite
LLM_API_KEY=your-api-key-here

# Dedicated Model Overrides (Optional)
GENERATION_MODEL=
EVALUATION_MODEL=

# Security & Authentication
# In production, generate a cryptographically secure secret (e.g. openssl rand -hex 32)
JWT_SECRET_KEY=dev-insecure-jwt-secret-key-change-in-production-intervai-auth-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Quality, RAG & Adaptive Engine Parameters
RAG_DUPLICATE_SIMILARITY_THRESHOLD=0.82
RAG_GROUNDING_SCORE_MINIMUM=0.65
RAG_CLAIM_SIMILARITY_MINIMUM=0.35
ADAPTIVE_ROLLING_WINDOW_SIZE=3
ADAPTIVE_CLAIM_QUOTA_PERCENT=0.20
ADAPTIVE_PROJECT_QUOTA_PERCENT=0.20
ADAPTIVE_HIGH_SCORE_THRESHOLD=75.0
ADAPTIVE_LOW_SCORE_THRESHOLD=50.0

# Feature Flags
PREFETCH_ENABLED=False

# Rate Limiting
RATE_LIMITING_ENABLED=True
RATE_LIMIT_NEXT_QUESTION_PER_MIN=20
RATE_LIMIT_EVALUATION_PER_MIN=25
RATE_LIMIT_RESUME_UPLOAD_PER_MIN=15
